# PHP: deny by default; only explicitly listed scripts below are reachable.
# Keeps leftovers, host defaults or planted *.php files from being executed via HTTP.
# Apache 2.4 (mod_authz_core) with the 2.2 syntax as fallback.
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>
# This site needs no PHP, so nothing is allowed.

# 1250-Jahrfeier (2017) und Bildergalerie wurden entfernt
<IfModule mod_alias.c>
  RedirectMatch 301 ^/aktuelles/1250-jahrfeier/?$ /unser-dorf/chronik/
  RedirectMatch 410 ^/gallery/
</IfModule>
